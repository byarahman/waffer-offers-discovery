{
  "name": "waffer-offers-discovery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Accessible, data-first offer discovery for the Waffer program",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:import": "python3 scripts/import_workbook.py",
    "test:data": "python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
